{
  "schema_version": 1,
  "module_id": "broca",
  "entries": [
    {
      "entry_id": "broca/durable-wals",
      "class": "portable",
      "mechanism": "filetree",
      "path": "wal-durable"
    },
    {
      "entry_id": "broca/durable-archive",
      "class": "portable",
      "mechanism": "filetree",
      "path": "wal-archive-durable"
    },
    {
            "entry_id": "broca/session-wals",
            "class": "excluded",
            "mechanism": "filetree",
            "path": "wal",
            "reason": "non-durable sessions (sidekicks, one-shots, consults, masons, other modules); only sessions marked durable are backed up, and none live in this tree"
    },
    {
            "entry_id": "broca/session-archive",
            "class": "excluded",
            "mechanism": "filetree",
            "path": "wal-archive",
            "reason": "folded non-durable sessions from wal/; only sessions marked durable are backed up, and none live in this tree"
    },
    {
      "entry_id": "broca/ephemeral-wals",
      "class": "excluded",
      "mechanism": "filetree",
      "path": "wal-ephemeral",
      "reason": "sessions with caller-chosen retention; an immutable backup snapshot would outlive that promise"
    },
    {
      "entry_id": "broca/durable-media",
      "class": "portable",
      "mechanism": "filetree",
      "path": "media-durable"
    },
    {
      "entry_id": "broca/session-media",
      "class": "excluded",
      "mechanism": "filetree",
      "path": "media",
      "reason": "non-durable sessions (sidekicks, one-shots, consults, masons, other modules); only sessions marked durable are backed up, and none live in this tree"
    },
    {
      "entry_id": "broca/ephemeral-media",
      "class": "excluded",
      "mechanism": "filetree",
      "path": "media-ephemeral",
      "reason": "sessions with caller-chosen retention; an immutable backup snapshot would outlive that promise"
    },
    {
      "entry_id": "broca/media-uploads",
      "class": "excluded",
      "mechanism": "filetree",
      "path": "media-uploads",
      "reason": "staged uploads are temporary input, not durable session data; an immutable backup snapshot would outlive their expiry"
    },
    {
      "entry_id": "broca/run-index",
      "class": "rebuild",
      "mechanism": "whole-db",
      "path": "run-index.db"
    },
    {
      "entry_id": "broca/caps",
      "class": "rebuild",
      "mechanism": "whole-db",
      "path": "caps.db"
    },
    {
      "entry_id": "broca/system-one",
      "class": "excluded",
      "mechanism": "whole-db",
      "path": "system-one.db",
      "reason": "System One batch answers hold caller text and are kept seven days after first admission; an immutable backup snapshot would outlive that promise, and a lost batch is re-sent and answered again"
    },
    {
      "entry_id": "broca/leases",
      "class": "device-local",
      "mechanism": "filetree",
      "path": "leases"
    },
    {
      "entry_id": "broca/request-dumps",
      "class": "device-local",
      "mechanism": "filetree",
      "path": "request-dumps"
    }
  ]
}
